NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/fde
# 32+ random chars: openssl rand -base64 48
JWT_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# lax works when the browser sees one origin (Vite proxy locally, Vercel rewrite in prod). Use none only for true cross-site (needs HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=120
LOGIN_RATE_LIMIT_PER_15MIN=20
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=60000
AGENT_RETRIES=1
MAINTENANCE_MODE=false
RUN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
# used only by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

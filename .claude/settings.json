{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./**/.env)", "Read(./package-lock.json)", "Read(./dist/**)", "Read(./node_modules/**)", "Edit(./.fde/**)", "Bash(git push:*)", "Bash(rm -rf:*)"]
  },
  "hooks": {
    "PostToolUse": [{ "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "npm run -s check:fast 2>&1 | tail -30 >&2 || exit 2" }] }]
  }
}
